# --- Adresse IP : renvoie vers home.lan (le port 3000 d'AdGuard reste ouvert en secours) ---
http://192.168.1.199 {
    redir http://home.lan{uri} 302
}
https://192.168.1.199 {
    tls internal
    redir https://home.lan{uri} 302
}
