{
    local_certs
    skip_install_trust
    auto_https disable_redirects
}

(admin) {
    basic_auth {
        admin $2a$14$REMPLACER_PAR_LE_HACHAGE_caddy_hash-password
    }
}

# --- Mes appareils : http redirigé vers https (TV, parents et autres restent en http) ---
# Pour ajouter ou retirer un appareil : modifie seulement la ligne remote_ip ci-dessous,
# puis recharge avec : bash ~/pack-maison/pages-maison/recharger-caddy-sur.sh
# Chaque adresse doit être réservée dans la Freebox (bail DHCP fixe), sinon elle change.
# 192.168.1.198 = tour, 192.168.1.71 = téléphone d'Alex.
(https_mes_appareils) {
    @mes_appareils {
        protocol http
        remote_ip 192.168.1.198 192.168.1.71
        not path /ca.crt /ca-info.json /certificat.html /maison-ca*
        not host exemple.duckdns.org *.exemple.duckdns.org
    }
    redir @mes_appareils https://{host}{uri} 302
}

# --- Https automatique (14/10/2026) : HSTS 1 jour sur les .lan en https (pas cloud.lan, jamais DuckDNS ni l'IP) ---
# Retour en arrière : bash ~/homelab/caddy/retour-https-auto.sh
(hsts_lan) {
    @hsts_lan {
        protocol https
        host *.lan
    }
    header @hsts_lan Strict-Transport-Security "max-age=86400"
}

# --- DuckDNS (local) : chaque site répond aussi à X.exemple.duckdns.org (et home à exemple.duckdns.org),
# en http et en https (tls internal, même autorité que les .lan), sans redirection vers https.
# Retour en arrière : cp Caddyfile.avant-duckdns Caddyfile (en place) puis recharger-caddy-sur.sh

# --- Famille ---
home.lan, http://home.lan, home.exemple.duckdns.org, http://home.exemple.duckdns.org, exemple.duckdns.org, http://exemple.duckdns.org {
    tls internal
    import https_mes_appareils
    import hsts_lan
    # types des fichiers du certificat (page certificat.html)
    @mobileconfig path *.mobileconfig
    header @mobileconfig Content-Type application/x-apple-aspen-config
    @crt path *.crt
    header @crt Content-Type application/x-x509-ca-cert
    @scripts path *.bat *.sh
    header @scripts Content-Type "text/plain; charset=utf-8"
    handle /api/* {
        reverse_proxy 127.0.0.1:8095
    }
    root * /srv/pages/home
    file_server
}
